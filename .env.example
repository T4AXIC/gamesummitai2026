# Not loaded automatically: export these in your shell, or pass them with docker run -e NAME=value.
# Set one of these to use a real model; leave all empty to use the offline mock.
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
# Optional: override the provider's default model name
PERDE_MODEL=
# Optional: OpenAI-compatible local server URL for the llamacpp provider
PERDE_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
